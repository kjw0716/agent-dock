{
  "name": "agent-dock",
  "version": "0.2.1",
  "description": "A small always-on-top Windows HUD: is each coding agent working, waiting for you, or done?",
  "main": "main.js",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node scripts/electron-sqlite.js",
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/sources.test.js test/agents.test.js test/asks.test.js test/channel.test.js test/plugin-install.test.js test/unread.test.js test/focus.test.js test/opencode.test.js test/jump.test.js test/history.test.js test/usage.test.js test/prices.test.js test/stats.test.js test/phone.test.js test/bark.test.js test/tailscale.test.js test/tasks.test.js test/phone-host.test.js test/chats.test.js test/push.test.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "keywords": [
    "windows",
    "electron",
    "desktop-widget",
    "hud",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "gemini-cli",
    "copilot",
    "developer-tools",
    "status"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kjw0716/agent-dock.git"
  },
  "homepage": "https://github.com/kjw0716/agent-dock",
  "bugs": {
    "url": "https://github.com/kjw0716/agent-dock/issues"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "build": {
    "appId": "com.kjw0716.agentdock",
    "productName": "Agent Dock",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "agents.js",
      "asks.js",
      "channel.js",
      "focus.js",
      "jump.js",
      "opencode.js",
      "plugin-install.js",
      "sources.js",
      "history.js",
      "prices.js",
      "stats.js",
      "tailscale.js",
      "tasks.js",
      "chats.js",
      "bark.js",
      "phone-host.js",
      "phone.js",
      "push.js",
      "stats-view.js",
      "mascots.js",
      "usage.js",
      "usage-worker.js",
      "unread.js",
      "assets/**",
      "phone/**",
      "claude-plugin/**",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Agent-Dock-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Agent Dock"
    }
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "web-push": "^3.6.7"
  }
}
